+/* =========================================================================
+   СЛОЙ 2 — КЛАССЫ, КОТОРЫЕ РАЗМЕТКА ИСПОЛЬЗУЕТ, А CSS НЕ ОПИСЫВАЛ.
+   94 таких класса в 30 компонентах из 50. Ниже — те, что встречаются
+   в нескольких компонентах, поэтому им место в глобальном слое.
+   Остальные (одиночные) переезжают в scoped-стили своих компонентов.
+   ========================================================================= */
+
+/* --- Тулбар списка. Встречался в 6 компонентах и не имел ни одного правила:
+       именно поэтому селект и «+ Добавить» стояли вплотную. --- */
+.projects-toolbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: var(--wolf-gap-group);
+  margin-bottom: var(--wolf-space-3);
+}
+
+.projects-toolbar-actions {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: var(--wolf-gap-group);
+}
+
+/* --- Формы. .form-row описан только в двух scoped-блоках, то есть
+       в остальных компонентах поля не выстраивались в ряд вообще. --- */
+.project-form,
+.life-area-form {
+  display: grid;
+  gap: var(--wolf-gap-block);
+}
+
+.form-row {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+  gap: var(--wolf-gap-group);
+}
+
+/* --- Разделитель перед необратимым действием.
+       «Удалить» больше не стоит в четырёх пикселях от «Изменить». --- */
+.life-area-actions > .confirm-inline,
+.projects-toolbar-actions > .confirm-inline,
+.project-link-actions > .confirm-inline {
+  margin-left: var(--wolf-space-1);
+  padding-left: var(--wolf-space-3);
+  border-left: 1px solid var(--wolf-rule);
+}
+
+.project-link-actions {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: var(--wolf-gap-inline);
+}
+
+/* --- Уменьшенные варианты элементов управления --- */
+.btn-sm {
+  min-height: var(--wolf-control-h);
+  padding: 3px var(--wolf-space-2);
+  font-size: var(--wolf-text-xs);
+}
+
+.input-sm {
+  min-height: var(--wolf-control-h);
+  padding: 4px var(--wolf-space-2);
+  font-size: var(--wolf-text-xs);
+}
+
+/* --- Опасное действие: до наведения приглушено, при наведении честно красное --- */
+.btn-danger-text:hover:not(:disabled),
+.btn-danger-text.is-armed {
+  background: var(--wolf-danger-surface);
+  color: var(--wolf-danger-ink);
+}
+
+/* --- Текст только для скринридеров.
+       Класс использовался в разметке и не имел стилей — то есть служебные
+       подписи были видны на экране обычным текстом. --- */
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+/* --- Сохранение переносов в пользовательском тексте --- */
+.preserve-lines { white-space: pre-wrap; }
+
+/* --- Списки связанных записей --- */
+.link-list {
+  display: grid;
+  gap: var(--wolf-space-1);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+/* --- Итоговые значения в агрегатах --- */
+.aggregate-mode {
+  color: var(--wolf-muted);
+  font-size: var(--wolf-text-xs);
+  letter-spacing: var(--wolf-track-label);
+  text-transform: uppercase;
+}
+
+.aggregate-total {
+  display: flex;
+  align-items: baseline;
+  gap: var(--wolf-gap-inline);
+}
+
+.aggregate-total-value {
+  color: var(--wolf-ink);
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+}
+
+/* --- Обёртки страниц: общий вертикальный ритм секций --- */
+.projects-page,
+.project-page,
+.delos-page,
+.ideas-page,
+.idea-detail-page,
+.spheres-page,
+.life-areas-page,
+.backlog-page,
+.calendar-page,
+.morning-page,
+.admin-users-page,
+.invites-page,
+.import-page,
+.settings-page,
+.scaffold-page {
+  display: grid;
+  gap: var(--wolf-gap-block);
+}
+
+.page-intro {
+  margin: 0 0 var(--wolf-gap-block);
+  color: var(--wolf-muted);
+  max-width: 68ch;
+}
+
+/* --- Селект в тулбаре не должен растягиваться на всю строку:
+       .input задаёт width 100%, из-за чего группа действий занимала
+       всю ширину и переносилась под заголовок. --- */
+.projects-toolbar-actions .input,
+.projects-toolbar-actions .filter-select,
+.filter-select {
+  width: auto;
+  min-width: 160px;
+  max-width: 100%;
+}
diff --git a/web/src/tokens.css b/web/src/tokens.css
new file mode 100644
index 0000000..606731a
--- /dev/null
+++ b/web/src/tokens.css
@@ -0,0 +1,106 @@
+/*
+  WOLF — Wolf's Own Life Framework
+  Copyright (C) 2025 Pavel Obukhov
+  Licensed under the GNU Affero General Public License v3 or later.
+
+  ТОКЕНЫ ДИЗАЙН-СИСТЕМЫ. Направление «Кабинет»: белый лист, тёплый ink вместо
+  чёрного, подложки вместо рамок. Цвета в интерфейсе нет — единственное цветное
+  пятно на экране это метка области жизни.
+
+  ПРАВИЛО: компонент не пишет hex, размер отступа или кегль напрямую.
+  Нужного оттенка нет — он добавляется сюда, а не в scoped-стили.
+
+  СОВМЕСТИМОСТЬ: имена --wolf-ink, --wolf-muted, --wolf-rule, --wolf-subrule,
+  --wolf-surface, --wolf-faint, --wolf-hover, --wolf-done-* уже используются
+  в компонентах (520 обращений). Они сохранены. Меняются только значения,
+  поэтому смена палитры не требует правок в компонентах.
+*/
+
+:root {
+  color-scheme: light;
+
+  /* ---------- Поверхности ---------- */
+  --wolf-surface:        #FFFFFF;  /* лист: фон страницы и карточек */
+  --wolf-card:           #FFFFFF;  /* использовался в AdminUsersView и не был объявлен */
+  --wolf-fill:           #F7F7F5;  /* подложка: поля ввода, сообщения, пустые состояния */
+  --wolf-fill-strong:    #EFEEEB;  /* подложка активнее: наведение на кнопку */
+  --wolf-hover:          #F7F7F5;  /* наведение на строку списка */
+
+  /* ---------- Текст ---------- */
+  --wolf-ink:            #37352F;  /* основной. Тёплый тёмно-серый, не чёрный */
+  --wolf-muted:          #787066;  /* вторичный: метаданные, подписи полей */
+  --wolf-faint:          #A5A093;  /* третичный: подсказки, плейсхолдеры */
+  --wolf-ink-hover:      #4A473F;  /* тёмная плашка под курсором */
+  --wolf-on-ink:         #FFFFFF;  /* текст на тёмной плашке */
+
+  /* ---------- Линии ---------- */
+  --wolf-rule:           #EAE9E5;  /* основная разделительная */
+  --wolf-subrule:        #F1F0ED;  /* внутренняя: между строками списка */
+
+  /* ---------- Состояния ---------- */
+  --wolf-done-ink:       #4D6A56;
+  --wolf-done-surface:   #F0F3F0;
+  --wolf-danger-ink:     #9B453A;
+  --wolf-danger-surface: #F6EDEB;
+  --wolf-focus:          #37352F;
+
+  /* ---------- Шкала отступов ----------
+     Одна геометрическая шкала. Произвольные значения запрещены. */
+  --wolf-space-1:  4px;
+  --wolf-space-2:  8px;
+  --wolf-space-3: 12px;
+  --wolf-space-4: 16px;
+  --wolf-space-5: 24px;
+  --wolf-space-6: 32px;
+  --wolf-space-7: 48px;
+
+  /* ---------- Четыре шага ритма ----------
+     Вместо 44 разных значений gap — четыре осмысленных.
+     Компонент выбирает по смыслу связи, а не на глаз. */
+  --wolf-gap-inline:  var(--wolf-space-2);  /*  8px — внутри группы: кнопки подряд, чип и текст */
+  --wolf-gap-group:   var(--wolf-space-4);  /* 16px — между группами: селект и кнопка в тулбаре */
+  --wolf-gap-block:   var(--wolf-space-5);  /* 24px — между блоками: форма и список */
+  --wolf-gap-section: var(--wolf-space-7);  /* 48px — между секциями страницы */
+
+  /* ---------- Форма ---------- */
+  --wolf-radius:    4px;
+  --wolf-radius-lg: 6px;
+
+  /* ---------- Элементы управления ----------
+     --wolf-tap поднимается до 44px на узких экранах (ниже).
+     Поэтому зона клика чинится один раз и сразу во всех компонентах. */
+  --wolf-control-h: 30px;
+  --wolf-tap:       30px;
+
+  /* ---------- Типографика ---------- */
+  --wolf-font: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI",
+               Helvetica, Arial, sans-serif;
+  --wolf-font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
+
+  --wolf-text-xs:   11px;    /* подписи полей, метаданные */
+  --wolf-text-sm:   12.5px;  /* кнопки, служебный текст */
+  --wolf-text-base: 13.5px;  /* основной текст интерфейса */
+  --wolf-text-lg:   15px;    /* заголовок пустого состояния */
+  --wolf-text-h1:   28px;    /* заголовок страницы */
+
+  --wolf-leading-tight: 1.2;
+  --wolf-leading-base:  1.5;
+  --wolf-leading-loose: 1.6;
+
+  --wolf-track-label: .08em;   /* трекинг капители в подписях */
+  --wolf-track-h1:    -.015em;
+
+  /* ---------- Движение ---------- */
+  --wolf-transition: .12s ease;
+}
+
+@media (max-width: 768px) {
+  :root {
+    --wolf-tap: 44px;      /* зона клика на телефоне */
+    --wolf-text-h1: 24px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  :root { --wolf-transition: 0s; }
+}
