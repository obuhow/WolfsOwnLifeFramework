# Конфигурация окружения WOLF.
#
# Скопируйте этот файл в .env рядом с docker-compose.yml и подставьте свои значения:
#
#     cp .env.example .env
#
# .env указан в .gitignore и не попадает в репозиторий. Реальные секреты в git не коммитятся.
# После правки .env примените изменения: docker compose up -d
#
# ВАЖНО: значения ниже — примеры формата, а не готовые к использованию. Каждое
# значение, помеченное «сгенерируйте», должно быть уникальным на вашей установке.

# ---------------------------------------------------------------------------
# База данных
# ---------------------------------------------------------------------------
POSTGRES_DB=wolf
POSTGRES_USER=wolf

# Пароль к базе. Сгенерируйте свой:
#     openssl rand -base64 24
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СГЕНЕРИРОВАННЫЙ_ПАРОЛЬ

# ---------------------------------------------------------------------------
# Подпись сессий (JWT)
# ---------------------------------------------------------------------------
# Ключ, которым подписываются токены входа. Кто знает этот ключ — может выпустить
# токен от имени любого пользователя, включая администратора. Минимум 32 байта.
# Сгенерируйте свой:
#     openssl rand -base64 48
#
# При смене ключа все выданные токены становятся недействительными и пользователям
# нужно войти заново — это нормально и является штатным способом «разлогинить всех».
WOLF_JWT_SECRET=ЗАМЕНИТЕ_НА_СГЕНЕРИРОВАННЫЙ_КЛЮЧ

# Время жизни токена в миллисекундах. По умолчанию 24 часа (86400000).
# WOLF_JWT_EXPIRATION_MS=86400000

# ---------------------------------------------------------------------------
# LLM-помощник (опционально)
# ---------------------------------------------------------------------------
# По умолчанию выключен. WOLF работает полностью без него.
# Включив, укажите совместимый с OpenAI API endpoint и свой ключ.
WOLF_LLM_ENABLED=false
WOLF_LLM_URL=https://api.x.ai/v1
WOLF_LLM_API_KEY=
WOLF_LLM_MODEL=grok-3-mini

# ---------------------------------------------------------------------------
# Сеть
# ---------------------------------------------------------------------------
# Порт, на котором веб-интерфейс слушает на хосте.
# Если перед WOLF стоит обратный прокси с TLS, обычно ставят 127.0.0.1-биндинг
# на уровне прокси, а сюда — внутренний порт.
WEB_HTTP_PORT=80
